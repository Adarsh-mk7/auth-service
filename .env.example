# ==============================================================================
# auth-service Environment Configuration Template
# Duplicate this file to .env and configure values for your environment.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL=postgresql://auth_user:auth_password@localhost:5432/auth_db?schema=public

# Redis Configuration (Optional; fallback to In-Memory if unavailable)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# JWT Secrets and Token Expiry
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long_12345
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-service-client

# Cookie Configuration
COOKIE_SECRET=your_super_secret_cookie_signing_key_min_32_characters_long_abcdef
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Password Policy & Hashing
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Password Reset Token
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# Google OAuth 2.0 Credentials (Optional in local dev mode)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Email Service Configuration (mock/development vs smtp)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@auth-service.local
FRONTEND_URL=http://localhost:3000
